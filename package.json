{
  "name": "bili-board-weekly",
  "version": "1.0.0",
  "private": true,
  "description": "Bili-Board_Atel 术力口周榜：抓取、整理、看板生成与定时更新",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "bbw": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js serve --build --open",
    "serve": "node src/cli.js serve",
    "crawl": "node src/cli.js crawl",
    "build": "node src/cli.js build",
    "update": "node src/cli.js update",
    "schedule": "node src/cli.js schedule",
    "migrate": "node scripts/migrate-legacy.mjs",
    "test": "node --test",
    "check": "node --check src/cli.js",
    "doctor": "node src/cli.js doctor",
    "package": "node scripts/package.mjs",
    "serve:bg": "powershell -ExecutionPolicy Bypass -File scripts/serve-bg.ps1",
    "serve:stop": "powershell -ExecutionPolicy Bypass -File scripts/serve-bg.ps1 -Stop",
    "serve:status": "powershell -ExecutionPolicy Bypass -File scripts/serve-bg.ps1 -Status"
  },
  "keywords": [
    "bilibili",
    "vocaloid",
    "chart",
    "weekly"
  ],
  "license": "MIT"
}
