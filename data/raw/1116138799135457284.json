e=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !important;\">第 7 名 - <a href=\"https://www.bilibili.com/video/BV1GxaVzREcV/\" target=\"_blank\">我告诉过你我爱你，对吗？</a></h1><p><br></p><figure class=\"img-box\" contenteditable=\"false\"><img alt=\"\" src=\"//i1.hdslb.com/bfs/archive/9800bb7e9f2f29862bb6f689a3b5a39d6d3c0093.jpg\"><figcaption class=\"caption\" contenteditable=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !important;\">第 6 名 - <a href=\"https://www.bilibili.com/video/BV1DFhmz2Ehn/\" target=\"_blank\">Doomer</a></h1><p><br></p><figure class=\"img-box\" contenteditable=\"false\"><img alt=\"\" src=\"//i2.hdslb.com/bfs/archive/7f65f1813d0d3a0bbd874ff974c1a8d5ed7f8b89.jpg\"><figcaption class=\"caption\" contenteditable=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !important;\">第 5 名 - <a href=\"https://www.bilibili.com/video/BV1zQWNzxESe/\" target=\"_blank\">欧帕兹</a></h1><p><br></p><figure class=\"img-box\" contenteditable=\"false\"><img alt=\"\" src=\"//i0.hdslb.com/bfs/archive/38a631516fa2aec009a00cd113cb6490476b92dc.jpg\"><figcaption class=\"caption\" contenteditable=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !important;\">第 4 名 - <a href=\"https://www.bilibili.com/video/BV1deYNzgEtQ/\" target=\"_blank\">重音teto到底能不能和miku一起逃离这场派对呢</a></h1><p><br></p><figure class=\"img-box\" contenteditable=\"false\"><img alt=\"\" src=\"//i1.hdslb.com/bfs/archive/5cf95433a14bc80ebb4ed433c6e96e5c35ef6786.jpg\"><figcaption class=\"caption\" contenteditable=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !important;\">第 3 名 - <a href=\"https://www.bilibili.com/video/BV1qDUPYKEzf/\" target=\"_blank\">视奸</a></h1><p><br></p><figure class=\"img-box\" contenteditable=\"false\"><img alt=\"\" src=\"//i2.hdslb.com/bfs/archive/cb57a835ced66703577b203f8dff9075dc2bc95b.jpg\"><figcaption class=\"caption\" contenteditable=\"\"></figcaption></figure><h1 style=\"margin: 14p