ditable=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !important;\">第 7 名 - <a href=\"https://www.bilibili.com/video/BV1xAVezxEkw/\" target=\"_blank\">怪物之歌</a></h1><p><br></p><figure class=\"img-box\" contenteditable=\"false\"><img alt=\"\" src=\"//i1.hdslb.com/bfs/archive/ef1239179dbcf92fea88bb21c606182afbb2a3a8.jpg\"><figcaption class=\"caption\" contenteditable=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !important;\">第 6 名 - <a href=\"https://www.bilibili.com/video/BV1qDUPYKEzf/\" target=\"_blank\">视奸</a></h1><p><br></p><figure class=\"img-box\" contenteditable=\"false\"><img alt=\"\" src=\"//i2.hdslb.com/bfs/archive/cb57a835ced66703577b203f8dff9075dc2bc95b.jpg\"><figcaption class=\"caption\" contenteditable=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !important;\">第 5 名 - <a href=\"https://www.bilibili.com/video/BV1YfJJzVEDF/\" target=\"_blank\">武装乙女</a></h1><p><br></p><figure class=\"img-box\" contenteditable=\"false\"><img alt=\"\" src=\"//i0.hdslb.com/bfs/archive/368f7078f2ace7dbe6663f5003573e0b81e87e11.jpg\"><figcaption class=\"caption\" contenteditable=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !important;\">第 4 名 - <a href=\"https://www.bilibili.com/video/BV1ZcKdzDE5Q/\" target=\"_blank\">捉迷藏</a></h1><p><br></p><figure class=\"img-box\" contenteditable=\"false\"><img alt=\"\" src=\"//i1.hdslb.com/bfs/archive/bf52f06cae3e58c1e88ebe8a589f830beb4fab8b.jpg\"><figcaption class=\"caption\" contenteditable=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !important;\">第 3 名 - <a href=\"https://www.bilibili.com/video/BV1z7gPzXEzJ/\" target=\"_blank\">像个笨蛋一样</a></h1><p><br></p><figure class=\"img-box\" contenteditable=\"false\"><img alt=\"\" src=\"//i1.hdslb.com/bfs/archive/5655555cc56ed25a4c4b33eb2edf9845c7c83f8a.jpg\"><figcaption class=\"caption\" contenteditable=\"\"></figcaption></figure><h1 style=\"margin: 14px 0; font-size: 23px !i